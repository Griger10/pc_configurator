<Window x:Class="PCConfigurator.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему"
        Height="360" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgMainBrush}"
        BorderBrush="{StaticResource CyanBrush}"
        BorderThickness="1">

    <StackPanel Margin="40,32,40,32" VerticalAlignment="Center">

        <!-- Заголовок -->
        <TextBlock Text="&gt;&gt; SYSTEM_LOGIN"
                   FontFamily="Consolas" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource CyanBrush}"
                   HorizontalAlignment="Center">
            <TextBlock.Effect>
                <DropShadowEffect Color="#00F5FF" BlurRadius="14" ShadowDepth="0" Opacity="0.9" />
            </TextBlock.Effect>
        </TextBlock>

        <TextBlock Text="PC CONFIGURATOR  v1.0"
                   FontFamily="Consolas" FontSize="9"
                   Foreground="{StaticResource TextDimBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,24" />

        <TextBlock Text="LOGIN:"
                   FontFamily="Consolas" FontSize="11"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,0,0,4" />
        <TextBox x:Name="LoginBox"
                 Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                 Background="{StaticResource BgSurfaceBrush}"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 BorderBrush="{StaticResource BorderDimBrush}"
                 BorderThickness="1"
                 Padding="8,6"
                 FontFamily="Consolas" FontSize="13"
                 CaretBrush="{StaticResource CyanBrush}"
                 Margin="0,0,0,12" />

        <TextBlock Text="PASSWORD:"
                   FontFamily="Consolas" FontSize="11"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,0,0,4" />
        <PasswordBox x:Name="PasswordBox"
                     PasswordChanged="PasswordBox_PasswordChanged"
                     Background="{StaticResource BgSurfaceBrush}"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     BorderBrush="{StaticResource BorderDimBrush}"
                     BorderThickness="1"
                     Padding="8,6"
                     FontFamily="Consolas" FontSize="13"
                     Margin="0,0,0,20" />

        <Button Content="[ ВОЙТИ ]"
                Command="{Binding LoginCommand}"
                Style="{StaticResource ActionButtonStyle}"
                HorizontalAlignment="Stretch"
                Height="36"
                FontSize="13" />

        <TextBlock Text="{Binding ErrorMessage}"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                   FontFamily="Consolas" FontSize="11"
                   Foreground="#FF4040"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Margin="0,12,0,0">
            <TextBlock.Effect>
                <DropShadowEffect Color="#FF0000" BlurRadius="8" ShadowDepth="0" Opacity="0.6" />
            </TextBlock.Effect>
        </TextBlock>

        <TextBlock Text="// проверка..."
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                   FontFamily="Consolas" FontSize="9"
                   Foreground="{StaticResource TextDimBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0" />

    </StackPanel>
</Window>
