<UserControl x:Class="PCConfigurator.UI.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource BgSurfaceBrush}" Padding="20,14"
                BorderBrush="{StaticResource CyanBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Накопители" Style="{StaticResource PageTitleStyle}" />
                <Button Content="Обновить"
                        Command="{Binding LoadCommand}"
                        Style="{StaticResource RefreshButtonStyle}"
                        Margin="16,0,0,0" />
            </StackPanel>
        </Border>
        <Border Grid.Row="1"
                Background="#050F1A"
                BorderBrush="{StaticResource BorderDimBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,6"
                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <Button Content="[ + ДОБАВИТЬ ]"
                        Command="{Binding StartAddCommand}"
                        Style="{StaticResource ActionButtonStyle}" />
                <Button Content="[ РЕДАКТИРОВАТЬ ]"
                        Command="{Binding StartEditCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="8,0,0,0" />
                <Button Content="[ УДАЛИТЬ ]"
                        Command="{Binding DeleteCommand}"
                        Style="{StaticResource ResetButtonStyle}"
                        Margin="8,0,0,0" />
                <TextBlock Text="{Binding EditStatus}"
                           Foreground="#FF4040"
                           Visibility="{Binding EditIsError, Converter={StaticResource BoolToVisibility}}"
                           FontFamily="Consolas" FontSize="11"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0" />
            </StackPanel>
        </Border>
        <Border Grid.Row="2"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource CyanBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12"
                Visibility="{Binding IsEditPanelOpen, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock FontFamily="Consolas" FontSize="11"
                           Foreground="{StaticResource GreenNeonBrush}"
                           Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="// РЕДАКТИРОВАНИЕ НАКОПИТЕЛЯ" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAddMode}" Value="True">
                                    <Setter Property="Text" Value="// ДОБАВИТЬ НАКОПИТЕЛЬ" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <WrapPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Text="ПРОИЗВОДИТЕЛЬ:" FontFamily="Consolas" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                        <ComboBox ItemsSource="{Binding AvailableManufacturers}"
                                  SelectedItem="{Binding EditManufacturer}"
                                  DisplayMemberPath="Name" Width="160"
                                  Background="{StaticResource BgRowBrush}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource BorderDimBrush}"
                                  FontFamily="Consolas" FontSize="12" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Text="МОДЕЛЬ:" FontFamily="Consolas" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding EditModel, UpdateSourceTrigger=PropertyChanged}"
                                 Width="200"
                                 Background="{StaticResource BgRowBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderDimBrush}"
                                 FontFamily="Consolas" FontSize="12" Padding="6,4" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Text="ТИП:" FontFamily="Consolas" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding EditType, UpdateSourceTrigger=PropertyChanged}"
                                 Width="80"
                                 Background="{StaticResource BgRowBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderDimBrush}"
                                 FontFamily="Consolas" FontSize="12" Padding="6,4" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Text="ОБЪЁМ ГБ:" FontFamily="Consolas" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding EditCapacity, UpdateSourceTrigger=PropertyChanged}"
                                 Width="80"
                                 Background="{StaticResource BgRowBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderDimBrush}"
                                 FontFamily="Consolas" FontSize="12" Padding="6,4" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Text="ИНТЕРФЕЙС:" FontFamily="Consolas" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding EditInterface, UpdateSourceTrigger=PropertyChanged}"
                                 Width="120"
                                 Background="{StaticResource BgRowBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderDimBrush}"
                                 FontFamily="Consolas" FontSize="12" Padding="6,4" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <Button Content="[ СОХРАНИТЬ ]"
                                Command="{Binding SaveEditCommand}"
                                Style="{StaticResource ActionButtonStyle}" />
                        <Button Content="[ ОТМЕНА ]"
                                Command="{Binding CancelEditCommand}"
                                Style="{StaticResource ResetButtonStyle}"
                                Margin="8,0,0,0" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="3"
                   Text="Загрузка данных..."
                   Style="{StaticResource LoadingStyle}"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Storages}"
                  SelectedItem="{Binding SelectedStorage, Mode=TwoWay}"
                  Margin="16">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"             Binding="{Binding StorageId}" Width="50" />
                <DataGridTextColumn Header="Производитель"  Binding="{Binding Manufacturer.Name}" Width="130" />
                <DataGridTextColumn Header="Модель"         Binding="{Binding Model}" Width="*" />
                <DataGridTextColumn Header="Тип"            Binding="{Binding Type}" Width="60" />
                <DataGridTextColumn Header="Объём, ГБ"      Binding="{Binding Capacity}" Width="90" />
                <DataGridTextColumn Header="Интерфейс"      Binding="{Binding Interface}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
