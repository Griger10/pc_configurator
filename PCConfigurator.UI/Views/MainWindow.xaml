<Window x:Class="PCConfigurator.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Конфигуратор ПК"
        Height="700" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMainBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Сайдбар -->
        <Border Grid.Column="0"
                Background="{StaticResource BgSidebarBrush}"
                BorderBrush="{StaticResource BorderDimBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Логотип / заголовок -->
                <Border DockPanel.Dock="Top" Padding="20,20,20,16"
                        BorderBrush="{StaticResource CyanBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="&gt;&gt; PC_CONFIG"
                                   Foreground="{StaticResource CyanBrush}"
                                   FontSize="15" FontWeight="Bold"
                                   FontFamily="Consolas">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#00F5FF" BlurRadius="12"
                                                  ShadowDepth="0" Opacity="0.8" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="КОНФИГУРАТОР ПК"
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="9" FontFamily="Consolas"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Навигация: каталог компонентов -->
                <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0">
                    <TextBlock Text="// КОМПОНЕНТЫ"
                               Foreground="{StaticResource GreenNeonBrush}"
                               FontSize="9" FontWeight="Bold"
                               FontFamily="Consolas"
                               Margin="20,0,0,6">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#00FF88" BlurRadius="6"
                                              ShadowDepth="0" Opacity="0.5" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <Button Content="  Процессоры"
                            Command="{Binding NavigateProcessorsCommand}"
                            Style="{StaticResource NavButtonStyle}" />
                    <Button Content="  Материнские платы"
                            Command="{Binding NavigateMotherboardsCommand}"
                            Style="{StaticResource NavButtonStyle}" />
                    <Button Content="  Оперативная память"
                            Command="{Binding NavigateRamCommand}"
                            Style="{StaticResource NavButtonStyle}" />
                    <Button Content="  Видеокарты"
                            Command="{Binding NavigateGpusCommand}"
                            Style="{StaticResource NavButtonStyle}" />
                    <Button Content="  Накопители"
                            Command="{Binding NavigateStorageCommand}"
                            Style="{StaticResource NavButtonStyle}" />
                </StackPanel>

                <!-- Разделитель -->
                <Border DockPanel.Dock="Top"
                        Height="1"
                        Margin="0,10"
                        Background="{StaticResource BorderDimBrush}" />

                <!-- Навигация: сборки -->
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="// СБОРКИ"
                               Foreground="{StaticResource GreenNeonBrush}"
                               FontSize="9" FontWeight="Bold"
                               FontFamily="Consolas"
                               Margin="20,0,0,6">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#00FF88" BlurRadius="6"
                                              ShadowDepth="0" Opacity="0.5" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <Button Content="  Мои конфигурации"
                            Command="{Binding NavigateConfigurationsCommand}"
                            Style="{StaticResource NavButtonStyle}" />
                    <Button Content="  Новая сборка"
                            Command="{Binding NavigateConfiguratorCommand}"
                            Style="{StaticResource NavButtonStyle}" />
                </StackPanel>

                <!-- Нижняя статусная строка -->
                <Border DockPanel.Dock="Bottom"
                        Height="28"
                        Background="#000005"
                        BorderBrush="{StaticResource BorderDimBrush}"
                        BorderThickness="0,1,0,0">
                    <TextBlock Text="[ SYS_READY ]"
                               Foreground="{StaticResource TextDimBrush}"
                               FontSize="8" FontFamily="Consolas"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </DockPanel>
        </Border>

        <!-- Основная область контента -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}"
                        Margin="0" />
    </Grid>
</Window>
